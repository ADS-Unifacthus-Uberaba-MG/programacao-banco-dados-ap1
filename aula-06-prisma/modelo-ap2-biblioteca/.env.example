# Copie este arquivo para .env antes de rodar o projeto:
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# NUNCA suba o .env para o GitHub (ele já está no .gitignore).

# PostgreSQL (Docker — Aula 2)
# Mesmo container, usuário, senha e porta (5433) da Aula 2.
# O banco "biblioteca" é separado do "bdaula" de propósito: o bdaula já tem uma
# tabela "produtos" da Aula 4, e o Prisma iria querer apagá-la.
# Não precisa criar o banco "biblioteca": o "npm run db:migrate" cria sozinho.
DATABASE_URL="postgresql://aluno:senha123@localhost:5433/biblioteca?schema=public"

# Plano B — MySQL/XAMPP (descomente e comente a linha acima)
# DATABASE_URL="mysql://root:@localhost:3306/biblioteca"
# DATABASE_HOST="localhost"
# DATABASE_USER="root"
# DATABASE_PASSWORD=""
# DATABASE_NAME="biblioteca"
