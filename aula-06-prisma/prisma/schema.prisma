// =============================================================
// schema.prisma — a "planta da casa" do nosso banco
// Aula 06 · Programação em Banco de Dados · UniFACTHUS
//
// Aqui descrevemos as tabelas. Depois o "prisma migrate dev"
// (a construtora) lê esta planta e cria a tabela de verdade no banco.
// =============================================================

// Gera o código do Prisma Client (o "controle remoto") na pasta generated/prisma
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Qual banco estamos usando. A URL de conexão NÃO fica aqui no Prisma 7:
// ela está no prisma7.config.ts (que lê o DATABASE_URL do .env).
datasource db {
  provider = "postgresql"
}

// Um "model" vira uma tabela. Cada linha abaixo vira uma coluna.
model Produto {
  // Chave primária (@id), número inteiro que o banco gera sozinho: 1, 2, 3...
  id           Int      @id @default(autoincrement())
  // Texto obrigatório (sem "?" = NOT NULL)
  nome         String
  // O "?" deixa o campo opcional: pode ficar vazio (NULL)
  descricao    String?
  // Decimal com 10 dígitos no total e 2 depois da vírgula (ex.: 12345678.90). Dinheiro nunca usa Float!
  preco        Decimal  @db.Decimal(10, 2)
  // Quantidade em estoque; se não informar, começa em 0
  estoque      Int      @default(0)
  // Produto à venda? Se não informar, começa como true (ativo)
  ativo        Boolean  @default(true)
  // Data/hora de criação, preenchida sozinha com o momento atual. No banco a coluna se chama criado_em
  criadoEm     DateTime @default(now()) @map("criado_em")
  // Atualizada sozinha pelo Prisma toda vez que o registro muda. No banco: atualizado_em
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // No código usamos "Produto"; no banco a tabela se chama "produtos"
  @@map("produtos")
}
