# Copie este arquivo para .env antes de rodar o projeto:
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# NUNCA suba o .env para o GitHub (ele já está no .gitignore).

# Usadas pelo docker-compose.yml para criar o container PostgreSQL (Aula 2)
POSTGRES_USER=aluno
POSTGRES_PASSWORD=senha123
POSTGRES_DB=bdaula

# Usada pelo Prisma (AP2 nº 1 — Biblioteca).
# Mesmo container, usuário, senha e porta (5433) de cima, mas no banco "biblioteca".
# Não precisa criar o banco: o "npm run db:migrate" cria sozinho.
DATABASE_URL="postgresql://aluno:senha123@localhost:5433/biblioteca?schema=public"
