# Copie este arquivo para .env (não o .env.example em si) antes de rodar o projeto:
#   cp .env.example .env
#
# Os valores abaixo já são os padrões deste projeto — não precisa trocar
# nada pra rodar localmente com o docker-compose.yml fornecido.

# Usadas pelo docker-compose.yml para configurar o container Postgres
POSTGRES_USER=aluno
POSTGRES_PASSWORD=senha123
POSTGRES_DB=bdaula

# Usadas pelo código TypeScript (src/db/connection.ts) para conectar ao banco
# a partir do seu computador (fora do container) — por isso a porta é 5433,
# não 5432 (veja o mapeamento de portas no docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USER=aluno
DB_PASSWORD=senha123
DB_NAME=bdaula
